{
  "id": "chat-suggest",
  "target": "[data-preview-target]",
  "controls": [
    {
      "id": "rows",
      "label": "Rows",
      "type": "select",
      "default": "2",
      "options": {
        "2": {
          "label": "2 rows",
          "removeClass": ["chat-suggest--rows-1"],
          "addClass": ["chat-suggest--rows-2"]
        },
        "1": {
          "label": "1 row",
          "removeClass": ["chat-suggest--rows-2"],
          "addClass": ["chat-suggest--rows-1"]
        }
      }
    }
  ]
}
